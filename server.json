{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.apatilgtn/architecture-diagrams",
  "title": "Architecture Diagrams",
  "description": "AWS, Azure and GCP architecture diagrams with official icons, reviews, Terraform and GCP import",
  "version": "1.2.0",
  "websiteUrl": "https://github.com/apatilgtn/architecture-diagrams/blob/main/docs/USER_GUIDE.md",
  "repository": {
    "url": "https://github.com/apatilgtn/architecture-diagrams",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "arch-diagram-mcp",
      "version": "1.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ARCH_DIAGRAM_OUTPUT_DIR",
          "description": "Folder for rendered diagrams (default: ~/architecture-diagrams)",
          "format": "filepath",
          "isRequired": false
        },
        {
          "name": "ARCH_DIAGRAM_INPUT_ROOTS",
          "description": "Folders the server may read Terraform or inventory files from, separated by the OS path separator",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "npm",
      "identifier": "arch-diagram-mcp",
      "version": "1.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ARCH_DIAGRAM_OUTPUT_DIR",
          "description": "Folder for rendered diagrams (default: ~/architecture-diagrams)",
          "format": "filepath",
          "isRequired": false
        },
        {
          "name": "ARCH_DIAGRAM_INPUT_ROOTS",
          "description": "Folders the server may read Terraform or inventory files from, separated by the OS path separator",
          "isRequired": false
        }
      ]
    }
  ]
}

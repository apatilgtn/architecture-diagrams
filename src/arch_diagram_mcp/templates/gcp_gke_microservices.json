{
  "id": "gcp_gke_microservices",
  "provider": "gcp",
  "description": "Regional GKE microservices platform: global LB + Cloud Armor + CDN, private GKE across zones, Cloud SQL HA, Memorystore, Pub/Sub, Secret Manager, Cloud NAT, Cloud Build.",
  "spec": {
    "title": "GCP GKE Microservices Platform",
    "filename": "gcp_gke_microservices",
    "direction": "LR",
    "clusters": [
      {"id": "gcp", "label": "Google Cloud - Org: example.com", "style": "rounded"},
      {"id": "proj", "label": "Project: platform-prod", "parent": "gcp", "style": "dashed"},
      {"id": "vpc", "label": "Shared VPC: prod-vpc", "parent": "proj", "bgcolor": "#EDF3FE"},
      {"id": "region", "label": "Region: europe-west2 (3 zones)", "parent": "vpc", "bgcolor": "#E4EDFD"},
      {"id": "gke", "label": "Private GKE cluster (regional)", "parent": "region", "bgcolor": "#DCE7FB"},
      {"id": "data", "label": "Managed Data (Private Service Access)", "parent": "region", "bgcolor": "#F3EEF8"},
      {"id": "ops", "label": "Security & Operations", "parent": "proj", "bgcolor": "#EEF6EA"},
      {"id": "cicd", "label": "CI/CD", "style": "dashed"}
    ],
    "nodes": [
      {"id": "users", "type": "onprem.client.Users", "label": "Users"},
      {"id": "dns", "type": "gcp.network.DNS", "label": "Cloud DNS", "cluster": "gcp"},
      {"id": "lb", "type": "gcp.network.LoadBalancing", "label": "Global External\nApp LB", "cluster": "gcp"},
      {"id": "armor", "type": "gcp.network.Armor", "label": "Cloud Armor", "cluster": "gcp"},
      {"id": "cdn", "type": "gcp.network.CDN", "label": "Cloud CDN", "cluster": "gcp"},
      {"id": "gw", "type": "k8s.network.Ingress", "label": "Gateway API", "cluster": "gke"},
      {"id": "frontend", "type": "k8s.compute.Deployment", "label": "frontend", "cluster": "gke"},
      {"id": "cart", "type": "k8s.compute.Deployment", "label": "cart-svc", "cluster": "gke"},
      {"id": "checkout", "type": "k8s.compute.Deployment", "label": "checkout-svc", "cluster": "gke"},
      {"id": "consumer", "type": "k8s.compute.Deployment", "label": "events-consumer", "cluster": "gke"},
      {"id": "sql", "type": "gcp.database.SQL", "label": "Cloud SQL Postgres\n(HA, PITR)", "cluster": "data"},
      {"id": "redis", "type": "gcp.database.Memorystore", "label": "Memorystore Redis\n(Standard tier)", "cluster": "data"},
      {"id": "pubsub", "type": "gcp.analytics.Pubsub", "label": "Pub/Sub", "cluster": "proj"},
      {"id": "gcs", "type": "gcp.storage.GCS", "label": "Cloud Storage", "cluster": "proj"},
      {"id": "nat", "type": "gcp.network.NAT", "label": "Cloud NAT", "cluster": "vpc"},
      {"id": "sm", "type": "gcp.security.SecretManager", "label": "Secret Manager", "cluster": "ops"},
      {"id": "kms", "type": "gcp.security.KMS", "label": "Cloud KMS (CMEK)", "cluster": "ops"},
      {"id": "iam", "type": "gcp.security.Iam", "label": "Workload Identity", "cluster": "ops"},
      {"id": "mon", "type": "gcp.operations.Monitoring", "label": "Cloud Monitoring", "cluster": "ops"},
      {"id": "logging", "type": "gcp.operations.Logging", "label": "Cloud Logging", "cluster": "ops"},
      {"id": "build", "type": "gcp.devtools.Build", "label": "Cloud Build", "cluster": "cicd"},
      {"id": "ar", "type": "gcp.devtools.GCR", "label": "Artifact Registry", "cluster": "cicd"}
    ],
    "edges": [
      {"source": "users", "target": "dns", "label": "HTTPS"},
      {"source": "dns", "target": "lb"},
      {"source": "armor", "target": "lb", "style": "dotted", "label": "policy"},
      {"source": "lb", "target": "cdn", "style": "dotted"},
      {"source": "lb", "target": "gw", "label": "NEG"},
      {"source": "gw", "target": "frontend"},
      {"source": "frontend", "target": "cart", "label": "gRPC"},
      {"source": "frontend", "target": "checkout", "label": "gRPC"},
      {"source": "cart", "target": "redis"},
      {"source": "checkout", "target": "sql"},
      {"source": "checkout", "target": "pubsub", "label": "order events"},
      {"source": "pubsub", "target": "consumer"},
      {"source": "consumer", "target": "gcs"},
      {"source": "checkout", "target": "nat", "style": "dashed", "label": "egress"},
      {"source": "iam", "target": "sm", "style": "dotted"},
      {"source": "sm", "target": "kms", "style": "dotted"},
      {"source": "checkout", "target": "mon", "style": "dotted", "color": "gray"},
      {"source": "mon", "target": "logging", "style": "dotted", "color": "gray"},
      {"source": "build", "target": "ar", "label": "push"},
      {"source": "ar", "target": "frontend", "style": "dashed", "label": "pull"}
    ]
  }
}
